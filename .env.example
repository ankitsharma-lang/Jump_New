# Server-only Contentful configuration
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# Contentful Optimization browser configuration
NEXT_PUBLIC_OPTIMIZATION_CLIENT_ID=
NEXT_PUBLIC_OPTIMIZATION_ENVIRONMENT=main

# Optional server aliases for the same Optimization destination
OPTIMIZATION_CLIENT_ID=
OPTIMIZATION_ENVIRONMENT=main

# Application-owned consent policy. Keep server and browser defaults aligned.
OPTIMIZATION_DEFAULT_CONSENT=true
OPTIMIZATION_DEFAULT_PERSISTENCE_CONSENT=true
NEXT_PUBLIC_OPTIMIZATION_DEFAULT_CONSENT=true
NEXT_PUBLIC_OPTIMIZATION_DEFAULT_PERSISTENCE_CONSENT=true

# Preview and webhook security
PREVIEW_SECRET=
CONTENTFUL_WEBHOOK_SECRET=

# Lab settings are only for an isolated, non-production deployment.
OPTIMIZATION_LAB_ISOLATED_DEPLOYMENT=false
OPTIMIZATION_LAB_SECRET=
OPTIMIZATION_LAB_CONTENTFUL_ENVIRONMENT=
